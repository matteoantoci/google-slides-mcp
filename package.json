{
  "name": "google-slides-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Slides integration",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "check": "npm run fmt:check && npm run lint && npm run typecheck",
    "get-token": "npm run build && node build/getRefreshToken.js",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.9.0",
    "googleapis": "^148.0.0",
    "open": "^10.1.1",
    "server-destroy": "^1.0.1",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/server-destroy": "^1.0.4",
    "oxc-config-ai-guardrails": "^0.1.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.0",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  }
}
