{
  "name": "google-slides-mcp",
  "version": "0.1.0",
  "description": "MCP server for Google Slides integration",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "check": "npm run fmt:check && npm run lint && npm run typecheck",
    "get-token": "npm run build && node build/getRefreshToken.js",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "googleapis": "^174.0.1",
    "open": "^11.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxc-config-ai-guardrails": "^0.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npm run check"
  },
  "engines": {
    "node": ">=20"
  }
}
